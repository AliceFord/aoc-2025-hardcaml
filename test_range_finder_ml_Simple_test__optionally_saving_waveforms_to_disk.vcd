$var wire 16 3 num_in $end
$var wire 1 . start $end
$upscope $end
$scope module -outputs $end
$var wire 1 9 ready_for_input $end
$scope module num_zeros $end
$var wire 1 - valid $end
$var wire 16 8 value $end
